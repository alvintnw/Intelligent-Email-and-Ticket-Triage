    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"technical_support\",\n        \"billing\",\n        \"sales_inquiry\",\n        \"complaint\",\n        \"feature_request\",\n        \"spam\",\n        \"other\"\n      ]\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\",\n        \"critical\"\n      ]\n    },\n    \"sentiment\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"positive\",\n        \"neutral\",\n        \"negative\"\n      ]\n    },\n    \"language\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"id\",\n        \"en\",\n        \"other\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"suggested_reply\": {\n      \"type\": \"string\"\n    },\n    \"confidence\": {\n      \"type\": \"number\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"urgency\",\n    \"sentiment\",\n    \"language\",\n    \"summary\",\n    \"suggested_reply\",\n    \"confidence\"\n  ]\n}"
      },
      "id": "cdb09b2b-7d18-4db8-9971-f8d3c8fd15db",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        620,
        520
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ====== KONFIGURASI (EDIT DI SINI) ======\nconst TEAMS = {\n  technical_support: { name: 'Tim Teknis',       chat: 'GANTI_CHAT_ID_TEKNIS' },\n  billing:           { name: 'Tim Finance',      chat: 'GANTI_CHAT_ID_FINANCE' },\n  sales_inquiry:     { name: 'Tim Sales',        chat: 'GANTI_CHAT_ID_SALES' },\n  complaint:         { name: 'Customer Success', chat: 'GANTI_CHAT_ID_CS' },\n  feature_request:   { name: 'Tim Produk',       chat: 'GANTI_CHAT_ID_PRODUK' },\n  other:             { name: 'Triase Manual',    chat: 'GANTI_CHAT_ID_TRIASE' },\n};\nconst MANAGER_CHAT = 'GANTI_CHAT_ID_MANAJER';\nconst SLA_HOURS = { critical: 1, high: 4, medium: 24, low: 72 };\nconst MIN_CONFIDENCE = 0.6;\n// =========================================\n\nconst base = $('Siapkan Data Tiket').item.json;\nconst raw = $json.output;\nconst failed = !raw || typeof raw !== 'object';\nconst o = failed ? {} : raw;\n\nconst pick = (v, allowed, fallback) => (allowed.includes(v) ? v : fallback);\nconst category = pick(o.category, ['technical_support','billing','sales_inquiry','complaint','feature_request','spam','other'], 'other');\nconst urgency = pick(o.urgency, ['low','medium','high','critical'], 'medium');\nconst sentiment = pick(o.sentiment, ['positive','neutral','negative'], 'neutral');\nconst language = pick(o.language, ['id','en','other'], 'en');\nconst confidence = Math.max(0, Math.min(1, Number(o.confidence) || 0));\nconst summary = String(o.summary || base.subject || '').slice(0, 500);\nconst suggestedReply = String(o.suggested_reply || '').slice(0, 1000);\n\nconst needsReview = failed || confidence < MIN_CONFIDENCE;\nconst isSpam = category === 'spam' && !needsReview;\nconst team = needsReview ? TEAMS.other : (TEAMS[category] || TEAMS.other);\nconst slaDue = new Date(Date.now() + SLA_HOURS[urgency] * 3600 * 1000).toISOString();\nconst noReply = /(no-?reply|do-?not-?reply|mailer-daemon|postmaster|bounce)/i.test(base.sender_email || '');\nconst autoReplyAllowed = !isSpam && !noReply;\n\nconst name = base.sender_name || base.sender_email;\nconst replyText = language === 'id'\n  ? `Halo ${name},\\n\\nTerima kasih telah menghubungi kami. Pesan Anda sudah kami terima dengan nomor tiket ${base.ticket_id} dan akan segera kami tindaklanjuti.\\n\\nSalam,\\nTim Dukungan`\n  : `Hello ${name},\\n\\nThank you for contacting us. We have received your message under ticket number ${base.ticket_id} and will follow up shortly.\\n\\nBest regards,\\nSupport Team`;\n\nconst emoji = { critical: '🚨', high: '🔴', medium: '🟡', low: '🟢' }[urgency];\nconst notificationText = (\n  `${emoji} TIKET ${base.ticket_id}\\n` +\n  `Kategori: ${category} | Urgensi: ${urgency} | Sentimen: ${sentiment}\\n` +\n  `Dari: ${name} <${base.sender_email}>\\n` +\n  `Subjek: ${base.subject}\\n\\n` +\n  `Ringkasan: ${summary}\\n\\n` +\n  `Draf balasan:\\n${suggestedReply || '-'}\\n\\n` +\n  `Tim: ${team.name}\\nSLA: ${slaDue}` +\n  (needsReview ? '\\n⚠️ Perlu review manual (confidence rendah atau triase gagal)' : '')\n).slice(0, 3800);\n\nconst escalationText = (\n  `🚨 TIKET KRITIS ${base.ticket_id}\\n` +\n  `${summary}\\n` +\n  `Dari: ${name} <${base.sender_email}>\\n` +\n  `Ditugaskan ke: ${team.name}\\nSLA: ${slaDue}`\n).slice(0, 3800);\n\nreturn {\n  json: {\n    ticket_id: base.ticket_id,\n    received_at: base.received_at,\n    sender_email: base.sender_email,\n    sender_name: base.sender_name,\n    subject: base.subject,\n    category, urgency, sentiment, language,\n    summary,\n    suggested_reply: suggestedReply,\n    confidence,\n    assigned_team: team.name,\n    sla_due: slaDue,\n    status: isSpam ? 'spam' : 'open',\n    triage_status: failed ? 'fallback' : (needsReview ? 'needs_review' : 'ok'),\n    thread_id: base.thread_id,\n    escalated: '',\n    escalated_at: '',\n    // field bantu (tidak masuk ke Sheet)\n    team_chat_id: team.chat,\n    manager_chat_id: MANAGER_CHAT,\n    notify: !isSpam,\n    is_critical: urgency === 'critical' && !isSpam,\n    auto_reply_allowed: autoReplyAllowed,\n    notification_text: notificationText,\n    escalation_text: escalationText,\n    reply_text: replyText,\n  }\n};"
      },
