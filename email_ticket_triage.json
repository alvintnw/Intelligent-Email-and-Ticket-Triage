        "jsCode": "// ====== KONFIGURASI (EDIT DI SINI) ======\nconst MANAGER_CHAT = 'GANTI_CHAT_ID_MANAJER';\n// =========================================\n\nconst now = Date.now();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const t = item.json;\n  const due = new Date(t.sla_due).getTime();\n  const status = String(t.status || '').toLowerCase();\n  const escalated = String(t.escalated || '').toLowerCase() === 'yes';\n\n  if (status === 'open' && !escalated && !isNaN(due) && due < now) {\n    const overdueMin = Math.round((now - due) / 60000);\n    out.push({\n      json: {\n        ticket_id: t.ticket_id,\n        manager_chat_id: MANAGER_CHAT,\n        alert_text: (\n          `⏰ SLA TERLEWAT: ${t.ticket_id}\\n` +\n          `Terlambat ${overdueMin} menit\\n` +\n          `Urgensi: ${t.urgency} | Tim: ${t.assigned_team}\\n` +\n          `Dari: ${t.sender_email}\\n` +\n          `Subjek: ${t.subject}\\n\\n` +\n          `Setelah ditangani, ubah status tiket di Sheet menjadi \"closed\".`\n        ).slice(0, 3800),\n      },\n    });\n  }\n}\nreturn out;"
      },
